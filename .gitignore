data/raw/**/*.zip
data/raw/**/*.tif
data/raw/**/*.tiff
data/processed/*
data/derived/vectors/*
data/derived/rasters/*

# Output editoriali rigenerabili e copie locali di progetto QGIS
outputs/handout/
outputs/slides/
qgis/allevamenti_stable*

# File temporanei/ausiliari GIS
data/**/*.gpkg-*
data/**/*.aux.xml
data/**/*.ovr
*.qgs~
*.qgz~

